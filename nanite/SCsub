#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

env_nanite = env.Clone()

# Allow nanite code to use engine internals like modules do.
env_nanite.Append(CPPDEFINES=["GODOT_MODULE"])

# meshoptimizer C API (vertex remap, meshlets, simplification, encoding).
env_nanite.Append(CPPPATH=["#thirdparty/meshoptimizer"])

# Note: nanite sources use `#include "nanite/core/..."` etc. (absolute from
# repo root) so no per-module CPPPATH is needed. This also fixes IntelliSense
# in the generated VS solution, which previously couldn't resolve the
# `core/...` / `gpu/...` paths because the engine itself has a top-level
# `core/` directory that shadowed them.

# Stage 1 bridge compile switch: define NANITE_BRIDGE_GDEXT when gdext or all.
nanite_bridge = env["nanite_bridge"]
if nanite_bridge in ("gdext", "all"):
    env_nanite.Append(CPPDEFINES=["NANITE_BRIDGE_GDEXT"])

nanite_sources = []

# Embed GLSL compute shaders as raw C string headers (parsed at runtime via
# RDShaderFile::parse_versions_from_text). Generates
# shaders/<name>.glsl.gen.h defining `<name>_shader_glsl`.
env_nanite.GLSL_HEADER("shaders/nanite_hzb_downsample.glsl")
env_nanite.GLSL_HEADER("shaders/nanite_cull.glsl")
env_nanite.GLSL_HEADER("shaders/nanite_rasterize.glsl")
env_nanite.GLSL_HEADER("shaders/nanite_material_resolve.glsl")
env_nanite.Depends(Glob("shaders/*.glsl.gen.h"), ["#glsl_builders.py"])

# register_types.cpp lives at the nanite/ top level (not under core/), so it
# must be added explicitly — the modules/SCsub loop expects
# initialize_nanite_module / uninitialize_nanite_module symbols to live in
# libnanite (since nanite is registered as a pseudo-module in SConstruct).
env_nanite.add_source_files(nanite_sources, "*.cpp")
env_nanite.add_source_files(nanite_sources, "core/*.cpp")
env_nanite.add_source_files(nanite_sources, "gpu/*.cpp")
env_nanite.add_source_files(nanite_sources, "scene/*.cpp")
env_nanite.add_source_files(nanite_sources, "bridge/*.cpp")

if env.editor_build:
    env_nanite.add_source_files(nanite_sources, "editor/*.cpp")

# Additional meshoptimizer sources not compiled by modules/meshoptimizer/SCsub.
# Godot's meshoptimizer module only exposes SurfaceTool-friendly helpers;
# meshlet utility APIs (meshopt_computeMeshletBounds, meshopt_optimizeMeshletLevel,
# meshopt_encodeMeshlet, meshopt_decodeMeshlet, etc.) live in meshletutils.cpp
# and meshletcodec.cpp, both of which Godot omits. Compile them directly into
# libnanite with warnings disabled.
nanite_thirdparty_sources = [
    "#thirdparty/meshoptimizer/meshletutils.cpp",
    "#thirdparty/meshoptimizer/meshletcodec.cpp",
]
env_nanite_thirdparty = env_nanite.Clone()
env_nanite_thirdparty.disable_warnings()
nanite_thirdparty_obj = []
env_nanite_thirdparty.add_source_files(nanite_thirdparty_obj, nanite_thirdparty_sources)
nanite_sources += nanite_thirdparty_obj

lib = env_nanite.add_library("nanite", nanite_sources)
env.Prepend(LIBS=[lib])

Export("env_nanite")
